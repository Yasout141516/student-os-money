# Internal integration secret from https://www.notion.so/my-integrations (needs Insert content capability)
NOTION_TOKEN=
# ID of your Student OS page (32 chars at the end of its URL); share it with the integration via ⋯ → Connections
NOTION_PARENT_PAGE_ID=
# Optional: ID of your Student OS Courses database, to link expenses to courses
NOTION_COURSES_DB_ID=

# Add-ons (Money Coach, quick-add web app): run `npm run ids` and paste the output here
EXPENSES_DS_ID=
CATEGORIES_DS_ID=
GOALS_DS_ID=
WALLET_PAGE_ID=
MONEY_PAGE_ID=
# PIN required by the web app (header x-pin)
APP_PIN=
# Extras: `npm run wishlist` prints WISHLIST_DS_ID; CRON_SECRET protects /api/cron-coach
WISHLIST_DS_ID=
CRON_SECRET=
